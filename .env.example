# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared backend (Supabase). Leave both empty in development to use the local
# JSON store at .data/dev-db.json. Local Supabase: `npx supabase start` prints these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash OTP codes. Use a long random string in every environment.
OTP_SECRET=change-me-to-a-long-random-string

# WhatsApp / SMS provider. Empty = messages are logged to the console (development only).
MESSAGING_PROVIDER=
