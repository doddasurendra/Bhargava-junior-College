# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared backend (Supabase). Leave both empty in development to use the local
# JSON store at .data/dev-db.json. Local Supabase: `npx supabase start` prints these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — used only server-side to verify staff email/password with Supabase Auth.
SUPABASE_ANON_KEY=

# Signs staff CRM session cookies. Use a long random string in every environment.
SESSION_SECRET=change-me-to-a-long-random-string

# Secret used to hash OTP codes. Use a long random string in every environment.
OTP_SECRET=change-me-to-a-long-random-string

# WhatsApp Business Cloud API. Leave MESSAGING_PROVIDER empty in development to log messages instead of sending.
# In production without it, messages (and OTPs) are not sent and are recorded as skipped.
# Set to whatsapp_cloud to send for real
MESSAGING_PROVIDER=
# Meta App → WhatsApp → API setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# System-user permanent token with the whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Meta App → Settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; enter the same value when registering the webhook
WHATSAPP_VERIFY_TOKEN=

# AI admission assistant (website chat). The SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
# Without credentials, or if the API is down, the rule-based assistant answers instead.
ANTHROPIC_API_KEY=
# Set to 1 to switch the AI off and use only the rule-based assistant.
ASSISTANT_DISABLED=

# Shared secret for the biometric hostel gate → POST /api/hostel/events (header x-device-key).
# Unset = the endpoint refuses every event.
HOSTEL_DEVICE_KEY=

# Protects /api/cron/whatsapp-reminders (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=
